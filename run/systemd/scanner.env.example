# Copy to /etc/scanner/scanner.env and replace every placeholder.
# Read by every unit through EnvironmentFile=; systemd reads it as root, so the file can be root:root 0600
# (the confirmation token is in it). systemd does not expand variables inside this file.

# Checkout of this repository and the interpreter that has its requirements installed.
SCANNER_HOME=/opt/scanner
SCANNER_PYTHON=/opt/scanner/.venv/bin/python

# Config of the campaign (settings.yaml, approval.yaml and the output live next to it).
SCANNER_CONFIG=/var/lib/scanner/work/config.yaml
# Confirmation token printed by `plan`.
SCANNER_CONFIRM=REPLACE_WITH_TOKEN

# Worker processes the coordinator starts.
SCANNER_NETWORK_WORKERS=4
SCANNER_FAVICON_WORKERS=2

# Limiter daemon socket; the workers find it through this variable.
SCANNER_LIMITER_SOCKET=/run/scanner/limiter.sock

# Python and allocator settings for long runs.
PYTHONUNBUFFERED=1
MALLOC_ARENA_MAX=2
