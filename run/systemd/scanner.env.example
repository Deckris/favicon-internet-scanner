# Copy to /etc/scanner/scanner.env (mode 0640) and replace every placeholder.
# Read by every unit through EnvironmentFile=; systemd does not expand variables inside this file.

# Checkout of this repository and the interpreter that has its requirements installed.
SCANNER_HOME=/opt/scanner
SCANNER_PYTHON=/opt/scanner/.venv/bin/python

# Settings and output folder of the campaign (settings.yaml, config.yaml, approval.yaml live here).
SCANNER_WORKDIR=/var/lib/scanner/work
SCANNER_CONFIG=/var/lib/scanner/work/config.yaml
# Confirmation token printed by `plan`.
SCANNER_CONFIRM=REPLACE_WITH_TOKEN

# Directory runtime sockets and logs are written to; must exist and belong to the unit user.
SCANNER_RUNTIME=/run/scanner
SCANNER_LOG_DIR=/var/log/scanner

# Limiter daemon socket, shared by the workers.
SCANNER_LIMITER_SOCKET=/run/scanner/limiter.sock

# Kill-switch file (operations.kill_switch_file of the config). Creating it stops every worker.
SCANNER_KILL_SWITCH=/var/lib/scanner/work/KILL

# Command arguments of the coordinator and of the ZMap worker, appended after `python -m scanner.internet`.
SCANNER_COORDINATOR_ARGS=coordinator --config /var/lib/scanner/work/config.yaml --confirm REPLACE_WITH_TOKEN
SCANNER_ZMAP_ARGS=zmap-worker --config /var/lib/scanner/work/config.yaml --confirm REPLACE_WITH_TOKEN
# Stage worker arguments; the stage (tls, http, dns, sni) and the favicon worker number come from the unit instance.
SCANNER_STAGE_ARGS=--config /var/lib/scanner/work/config.yaml --confirm REPLACE_WITH_TOKEN

# Worker recycling (see scanner.internet.recycle): exit code 75 makes systemd start a fresh process.
SCANNER_RECYCLE_SHARDS=20
SCANNER_RECYCLE_RSS_MIB=2400

# Python and allocator settings for long runs.
PYTHONUNBUFFERED=1
MALLOC_ARENA_MAX=2
