#!/usr/bin/env bash
# scanner - single entry point for the scanner (native Python or Docker).
#
#   scanner [--docker|--native] [--workdir DIR] [--config FILE] COMMAND [options]
#
# All limits (approval, rate cap, egress guard, kill switch, run-once guard) are enforced by the
# Python program, not by this script; the script only starts it the same way every time.
set -euo pipefail

PKG_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MODE="${SCANNER_MODE:-native}"
WORKDIR="$PWD"
CONFIG="config.yaml"
IMAGE="${SCANNER_IMAGE:-scanner:1}"
NAME="scanner-run"
PY="${SCANNER_PYTHON:-$HOME/scanner-venv/bin/python}"
# Git Bash (Windows) rewrites paths such as /work in arguments to docker; stop it for docker only (git needs the rewriting).
docker() { MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*' command docker "$@"; }
# Docker mode runs as you on Linux. A folder on a Windows drive is mounted owned by root and no other user can write
# to it, so there the container user is root (still read-only, no capabilities except raw sockets).
case "$(uname -s 2>/dev/null)" in
  MINGW*|MSYS*|CYGWIN*) DEFAULT_DOCKER_USER=0:0 ;;
  *) DEFAULT_DOCKER_USER="$(id -u):$(id -g)" ;;
esac
DOCKER_USER="${SCANNER_DOCKER_USER:-$DEFAULT_DOCKER_USER}"

usage() {
  cat <<'EOF'
usage: scanner [--docker|--native] [--workdir DIR] COMMAND [options]
       scanner help COMMAND        details and examples for one command

Set up (once):
  init                           create settings.yaml: the one file with contact, addresses, exclusions, limits
  exclusions                     add opt-out ranges to the exclusion list
  apply                          check settings.yaml and generate config.yaml + approval.yaml (done automatically)

Run:
  doctor [--offline]             check the host, address, tools and approval (sends almost nothing)
  plan                           show what would be scanned and the confirmation token (sends nothing)
  run --confirm TOKEN            run the pipeline: ZMap -> ZGrab2 -> ZDNS -> favicons
  stop                           ask a running scan to stop
  summary RUN_DIR                print the run's report
  pack RUN_DIR [--with-results]  make an archive: manifest and report only; --with-results adds per-address files
  export-csv RUN_DIR [--out FILE]  write the hostname table of a run as CSV (runs no longer store it)
  campaign --confirm TOKEN       run every shard of a sharded config (see `scanner help campaign`)
  compact RUN_DIR                compress the per-address files of a finished run
  prune-raw RUN_DIR              delete raw/ of a compacted run
  export-shard RUN_DIR DEST      copy a finished shard to another disk, verified
  export-network RUN_DIR OUT_DIR copy a network-only shard so its favicon stage can run elsewhere
  favicon-stage RUN_DIR --confirm TOKEN   run the favicon stage of a network-only shard
  import-favicons RUN_DIR FAV_RUN_DIR     take the favicon outputs of another host into a network-only shard

Other:
  build                          docker mode: build the image from this package
  verify                         offline test suite (sends nothing)
  favicons --source-run DIR      repeat the favicon lookups of a finished run

--workdir holds settings.yaml, the exclusion list and the output folder (default: current directory).
Docker mode needs host networking and runs without root, with only the raw-socket capability.
All limits are enforced by the Python program, not by this script.
EOF
}

cmd_help() {
  case "${1:-}" in
    init) cat <<'EOF'
scanner init [--contact EMAIL] [--info-url URL] [--egress-ip IP] [--source-ip IP] [--interface IF]
             [--resolver IP] [--incident-contact EMAIL] [--exclusions FILE] [--label NAME] [--force]

Writes settings.yaml into the work folder. Anything you leave out is written as REPLACE_ME and must be
filled in before `scanner apply` accepts it. --exclusions FILE copies the list from the network owner to
exclusions.txt.
  scanner --workdir ~/scan init --contact scan-optout@uni.example --info-url https://uni.example/scan \
          --egress-ip 192.0.2.10 --interface eth0 --resolver 192.0.2.53 --exclusions owner-list.txt
EOF
    ;;
    apply) cat <<'EOF'
scanner apply

Validates settings.yaml (e-mail, URL, addresses, rate and size against the approved caps, exclusion list) and
writes config.yaml and approval.yaml, with the exclusion list's checksum in both. It runs by itself before
doctor, plan, run and favicons, and tells you in plain words what is missing.
EOF
    ;;
    exclusions) cat <<'EOF'
scanner exclusions --add CIDR [CIDR ...] | --from-file FILE

Adds ranges (an opt-out, or a list from the network owner) to the exclusion list named in settings.yaml.
Run `scanner apply` afterwards (it runs automatically before the next plan) so the checksum follows; a changed
list means a new plan token.
  scanner exclusions --add 203.0.113.0/24 198.51.100.7/32
EOF
    ;;
    doctor) cat <<'EOF'
scanner doctor [--offline]

Checks the tools, the approval, the exclusion list, the source address and the DNS resolver. --offline skips
the network checks. With egress_check auto and no NAT it reads the address from the network card and asks no
outside service.
EOF
    ;;
    plan) cat <<'EOF'
scanner plan

Prints targets, ports, rate, estimated time and the confirmation token. Sends nothing.
EOF
    ;;
    run) cat <<'EOF'
scanner run --confirm TOKEN [--allow-rerun] [--skip-pilot-check]

Runs the pipeline. Refused without a contact and information page, past the approved rate or size, outside the
approval's validity, and for a large sample until a small pilot has completed (--skip-pilot-check overrides the
last). Requests to one address are spaced by min_seconds_between_probes_per_ip (5 s or more). `scanner stop` ends it.
EOF
    ;;
    campaign|favicon-stage|export-network|import-favicons|export-shard|compact|prune-raw) cat <<'EOF'
scanner campaign --confirm TOKEN [--shards-from N] [--shards-to N] [--pipeline 1|2] [--stop-after-network] [--no-resume]
scanner favicon-stage RUN_DIR --confirm TOKEN
scanner export-network RUN_DIR OUT_DIR | import-favicons RUN_DIR FAV_RUN_DIR | export-shard RUN_DIR DEST [--remove-source]
scanner compact RUN_DIR | prune-raw RUN_DIR

Same program, same checks as `run`; RUN_DIR and the other folders are paths relative to --workdir. In docker mode
they must lie inside --workdir. The settings flags of `apply` (--icon-selection, --javascript-enabled, ...) are
accepted by init, apply and plan; `plan` shows the result under favicon_settings.
EOF
    ;;
    stop|summary|pack|export-csv|build|verify|favicons) usage ;;
    *) usage ;;
  esac
}

die() { echo "scanner: $*" >&2; exit 2; }

ARGS=(); HELP=0
while [ $# -gt 0 ]; do
  case "$1" in
    --docker) MODE=docker; shift ;;
    --native) MODE=native; shift ;;
    --workdir) WORKDIR="${2:?--workdir needs a directory}"; shift 2 ;;
    --config) CONFIG="${2:?--config needs a file}"; shift 2 ;;
    -h|--help) HELP=1; shift ;;
    help) if [ ${#ARGS[@]} -eq 0 ]; then HELP=1; shift; else ARGS+=("$1"); shift; fi ;;   # only the command word, not a value
    *) ARGS+=("$1"); shift ;;
  esac
done
if [ "$HELP" = 1 ]; then cmd_help "${ARGS[0]:-}"; exit 0; fi
[ ${#ARGS[@]} -gt 0 ] || { usage >&2; exit 2; }
CMD="${ARGS[0]}"; REST=("${ARGS[@]:1}")
if [ ! -d "$WORKDIR" ]; then
  case "$CMD" in
    init|verify) mkdir -p "$WORKDIR" || die "cannot create the work folder $WORKDIR" ;;
    build) ;;
    *) die "the work folder $WORKDIR does not exist; create it with: scanner --workdir $WORKDIR init ..." ;;
  esac
fi
[ -d "$WORKDIR" ] && WORKDIR="$(cd "$WORKDIR" && pwd)"
case "$CONFIG" in /*) CONFIG_ABS="$CONFIG" ;; *) CONFIG_ABS="$WORKDIR/$CONFIG" ;; esac

# Paths as the program sees them (inside the container the workdir is /work).
if [ "$MODE" = docker ]; then
  case "$CONFIG_ABS" in "$WORKDIR"/*) CONFIG_IN="/work/${CONFIG_ABS#"$WORKDIR"/}" ;; *) die "in docker mode --config must be inside --workdir" ;; esac
else
  CONFIG_IN="$CONFIG_ABS"
fi

host_path() {   # a path as docker.exe wants it (C:/Users/... under Git Bash on Windows)
  if command -v cygpath >/dev/null 2>&1; then cygpath -m "$1"; else printf '%s
' "$1"; fi
}

docker_ready() {
  command -v docker >/dev/null || die "docker not found"
  docker info >/dev/null 2>&1 || die "Docker is not running (start Docker Desktop, or the docker service on Linux)"
}

package_version() { git -C "$PKG_ROOT" rev-parse --short=12 HEAD 2>/dev/null || echo unversioned; }

# The image must have been built from this package, not an older one that happens to carry the same tag.
check_image() {
  docker_ready
  local built now
  built="$(docker image inspect -f '{{index .Config.Labels "org.opencontainers.image.version"}}' "$IMAGE" 2>/dev/null)"     || die "image $IMAGE not found (build it: scanner --docker build)"
  now="$(package_version)"
  if [ "$now" != unversioned ] && [ "$built" != "$now" ]; then
    die "image $IMAGE was built from package version '$built' but this package is '$now'; rebuild: scanner --docker build"
  fi
}

# Run the scanner program; $1.. are its arguments.
scanner() {
  if [ "$MODE" = docker ]; then
    check_image
    local tty=()
    [ -t 0 ] && [ -t 1 ] && tty=(-it)
    docker run --rm --init "${tty[@]}" --name "$NAME" --stop-timeout 60 \
      --network host --cap-drop ALL --cap-add NET_RAW \
      --user "$DOCKER_USER" --read-only --tmpfs /tmp \
      -v "$(host_path "$WORKDIR"):/work" -w /work "$IMAGE" "$@"
  else
    [ -x "$PY" ] || die "python venv not found at $PY (run: sudo bash run/setup-wsl.sh)"
    PYTHONPATH="$PKG_ROOT" PYTHONDONTWRITEBYTECODE=1 "$PY" -m scanner.internet "$@"
  fi
}

kill_switch() {   # path of the kill-switch file as the program sees it
  local ks
  ks=$(awk '/^[[:space:]]*kill_switch_file:/ {print $2; exit}' "$CONFIG_ABS" | tr -d "\"'")
  [ -n "$ks" ] || die "no operations.kill_switch_file in $CONFIG_ABS"
  case "$ks" in /*) echo "$ks" ;; *) echo "$(dirname "$CONFIG_IN")/$ks" ;; esac
}

WORK_IN="$WORKDIR"; [ "$MODE" = docker ] && WORK_IN=/work

# A file named on the command line (an exclusion list) must be visible to the program. In Docker mode a file outside
# the work folder is copied into it for the duration of the command.
STAGED=()
trap 'rm -f ${STAGED[@]+"${STAGED[@]}"}' EXIT
stage_in() {   # sets STAGED_PATH (not a subshell, so the cleanup list is kept)
  local f="$1" abs name
  STAGED_PATH="$f"
  if [ "$MODE" != docker ] || [ ! -f "$f" ]; then return; fi
  abs="$(cd "$(dirname "$f")" && pwd)/$(basename "$f")"
  case "$abs" in "$WORKDIR"/*) STAGED_PATH="/work/${abs#"$WORKDIR"/}"; return ;; esac
  name=".import-$$-$(basename "$f")"
  cp "$f" "$WORKDIR/$name"; STAGED+=("$WORKDIR/$name")
  STAGED_PATH="/work/$name"
}
stage_args() {   # prints the arguments with the file after --exclusions / --from-file made visible
  local out=() prev=""
  for a in "$@"; do
    if [ "$prev" = "--exclusions" ] || [ "$prev" = "--from-file" ]; then stage_in "$a"; out+=("$STAGED_PATH"); else out+=("$a"); fi
    prev="$a"
  done
  REST=("${out[@]+"${out[@]}"}")
}

# The flags that change settings.yaml's output (resources, concurrency, icons, JavaScript); doctor, plan and run apply them too.
SETTINGS_FLAGS=()
collect_settings_flags() {
  SETTINGS_FLAGS=()
  local i=0 a
  while [ $i -lt ${#REST[@]} ]; do
    a="${REST[$i]}"
    case "$a" in
      --cores|--memory-gb|--max-open-files|--zgrab-senders|--zgrab-parallel-batches|--zgrab-batch-size|--dns-threads|--favicon-workers|--favicon-processes|--favicon-max-active-requests|--favicon-stage-max-seconds|--overlap-tls-with-zmap|--max-connections-per-subnet|--icon-selection|--offhost-icons|--javascript-enabled|--javascript-max-pages-per-shard|--javascript-page-timeout-seconds|--javascript-concurrency|--javascript-wait-ms)
        SETTINGS_FLAGS+=("$a" "${REST[$((i + 1))]:?$a needs a value}"); i=$((i + 2)) ;;
      *) i=$((i + 1)) ;;
    esac
  done
}

# A folder argument as the program sees it: relative to --workdir, and inside it in docker mode.
path_in() {
  local p="$1"
  case "$p" in /*) ;; *) p="$WORKDIR/$p" ;; esac
  if [ "$MODE" = docker ]; then
    case "$p" in "$WORKDIR"/*) p="/work/${p#"$WORKDIR"/}" ;; *) die "$1 must be inside --workdir in docker mode" ;; esac
  fi
  PATH_IN="$p"
}

# Arguments of a command with folder arguments: the first $1 positional words and the values of --archive-to / --out are paths.
map_paths() {
  local want="$1" seen=0 prev="" a out=()
  shift
  for a in "$@"; do
    if [ "$prev" = "--archive-to" ] || [ "$prev" = "--out" ]; then path_in "$a"; out+=("$PATH_IN")
    else
      case "$a" in
        -*) out+=("$a") ;;
        *) case "$prev" in
             --confirm|--shards-from|--shards-to|--pipeline|--archive-when-free-gb-below|--run-id|--shard|--config) out+=("$a") ;;
             *) if [ $seen -lt "$want" ]; then path_in "$a"; out+=("$PATH_IN"); seen=$((seen + 1)); else out+=("$a"); fi ;;
           esac ;;
      esac
    fi
    prev="$a"
  done
  REST=("${out[@]+"${out[@]}"}")
}

# settings.yaml is the one file people edit; make config.yaml and approval.yaml follow it.
ensure_applied() {
  [ -f "$WORKDIR/settings.yaml" ] || return 0
  collect_settings_flags
  scanner apply --workdir "$WORK_IN" "${SETTINGS_FLAGS[@]+"${SETTINGS_FLAGS[@]}"}" >/dev/null || die "settings.yaml needs attention (run: scanner apply)"
}

case "$CMD" in
  init)       stage_args "${REST[@]+"${REST[@]}"}"; scanner init --workdir "$WORK_IN" "${REST[@]+"${REST[@]}"}" ;;
  apply)      scanner apply --workdir "$WORK_IN" "${REST[@]+"${REST[@]}"}" ;;
  exclusions) stage_args "${REST[@]+"${REST[@]}"}"; scanner exclusions --workdir "$WORK_IN" "${REST[@]+"${REST[@]}"}" ;;
  build)
    [ "$MODE" = docker ] || die "build is for docker mode (use --docker)"
    docker_ready
    docker build -f "$(host_path "$PKG_ROOT")/run/Dockerfile" --build-arg "PACKAGE_VERSION=$(package_version)" \
      -t "$IMAGE" "$(host_path "$PKG_ROOT")"
    ;;
  verify)
    out="$WORKDIR/verify-$(date -u +%Y%m%dT%H%M%SZ)"
    if [ "$MODE" = docker ]; then
      check_image
      docker run --rm --init --network none --user "$DOCKER_USER" --read-only --tmpfs /tmp:rw,exec \
        -v "$(host_path "$WORKDIR"):/work" -w /work --entrypoint python "$IMAGE" /opt/app/run/verify_offline.py --output "/work/${out##*/}"
    else
      [ -x "$PY" ] || die "python venv not found at $PY"
      "$PY" "$PKG_ROOT/run/verify_offline.py" --output "$out"
    fi
    echo "test results are in $out"
    ;;
  doctor)    ensure_applied; scanner preflight --config "$CONFIG_IN" "${REST[@]}" ;;
  plan)      ensure_applied; scanner plan --config "$CONFIG_IN" "${SETTINGS_FLAGS[@]+"${SETTINGS_FLAGS[@]}"}" ;;
  run)       ensure_applied; scanner run --config "$CONFIG_IN" "${REST[@]}" ;;
  campaign)   ensure_applied; map_paths 0 "${REST[@]+"${REST[@]}"}"; scanner campaign --config "$CONFIG_IN" "${REST[@]+"${REST[@]}"}" ;;
  favicon-stage) ensure_applied; map_paths 1 "${REST[@]+"${REST[@]}"}"; scanner favicon-stage --config "$CONFIG_IN" "${REST[@]+"${REST[@]}"}" ;;
  export-network|import-favicons) map_paths 2 "${REST[@]+"${REST[@]}"}"; scanner "$CMD" "${REST[@]+"${REST[@]}"}" ;;
  export-shard)
    map_paths 2 "${REST[@]+"${REST[@]}"}"
    cfgopt=(); [ -f "$CONFIG_ABS" ] && cfgopt=(--config "$CONFIG_IN")
    scanner export-shard "${cfgopt[@]+"${cfgopt[@]}"}" "${REST[@]+"${REST[@]}"}"
    ;;
  compact|prune-raw) map_paths 1 "${REST[@]+"${REST[@]}"}"; scanner "$CMD" "${REST[@]+"${REST[@]}"}" ;;
  favicons)
    src=""; extra=()
    while [ ${#REST[@]} -gt 0 ]; do
      case "${REST[0]}" in
        --source-run) src="${REST[1]:?--source-run needs a directory}"; REST=("${REST[@]:2}") ;;
        *) extra+=("${REST[0]}"); REST=("${REST[@]:1}") ;;
      esac
    done
    [ -n "$src" ] || die "favicons needs --source-run DIR"
    case "$src" in /*) ;; *) src="$WORKDIR/$src" ;; esac
    if [ "$MODE" = docker ]; then case "$src" in "$WORKDIR"/*) src="/work/${src#"$WORKDIR"/}" ;; *) die "--source-run must be inside --workdir in docker mode" ;; esac; fi
    ensure_applied
    scanner favicon-refetch --config "$CONFIG_IN" --source-run "$src" "${extra[@]}"
    ;;
  stop)
    ks="$(kill_switch)"
    if [ "$MODE" = docker ]; then docker exec "$NAME" touch "$ks"; else touch "$ks"; fi
    echo "stop requested: $ks (the running stage stops within a few seconds; the run is marked partial)"
    ;;
  summary)
    [ ${#REST[@]} -ge 1 ] || die "summary needs RUN_DIR"
    cat "${REST[0]}/report/summary.md"
    ;;
  export-csv)
    [ ${#REST[@]} -ge 1 ] || die "export-csv needs RUN_DIR"
    src="${REST[0]}"; outopt=()
    if [ "${REST[1]:-}" = "--out" ]; then outopt=(--out "${REST[2]:?--out needs a file}"); fi
    case "$src" in /*) ;; *) src="$WORKDIR/$src" ;; esac
    if [ "$MODE" = docker ]; then case "$src" in "$WORKDIR"/*) src="/work/${src#"$WORKDIR"/}" ;; *) die "RUN_DIR must be inside --workdir in docker mode" ;; esac; fi
    scanner export-csv "$src" "${outopt[@]}"
    ;;
  pack)
    [ ${#REST[@]} -ge 1 ] || die "pack needs RUN_DIR"
    run="$(cd "${REST[0]}" && pwd)"; base="$(basename "$run")"; results=0; raw=0
    for opt in "${REST[@]:1}"; do
      case "$opt" in
        --with-results) results=1 ;;
        --with-raw) results=1; raw=1 ;;
        *) die "unknown pack option: $opt (use --with-results or --with-raw)" ;;
      esac
    done
    grep -q '"complete": true' "$run/manifest.json" || echo "scanner: WARNING: this run's manifest is not marked complete" >&2
    # Default: the manifest and the aggregate report only. Per-address results and raw tool output contain IPs,
    # host names and certificate names, so they are added only on request. The hostname table in normalized/ is
    # slim and needs endpoints.jsonl next to it, which the archive holds; `export-csv` rebuilds the CSV from it.
    items=("$base/manifest.json" "$base/report")
    if [ "$results" -eq 1 ]; then
      for f in normalized ip_results.csv ip_results.csv.zst scanned_ips.txt favicons; do [ -e "$run/$f" ] && items+=("$base/$f"); done
    fi
    [ "$raw" -eq 1 ] && items+=("$base/raw")
    tarball="$run.results.tar.gz"
    tar -C "$(dirname "$run")" -czf "$tarball" "${items[@]}"
    ( cd "$(dirname "$tarball")" && sha256sum "$(basename "$tarball")" | tee "$(basename "$tarball").SHA256SUMS" )
    ls -l "$tarball"
    ;;
  *) usage >&2; die "unknown command: $CMD" ;;
esac
